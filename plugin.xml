<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<plugin xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Severino/Spacialist/refs/heads/0.12-feat-plugin-xml-schema/schemas/plugin-xml/v1/schema.xsd">
    <name>Template</name>
    <title>Template Plugin</title>
    <description>Base template for creating Plugins for Spacialist.</description>
    <version>1.0.0</version>
    <licence>MIT</licence>
    <authors>
        <author>Severin Opel</author>
    </authors>
    <routes src="routes/api.php" middleware="api"/>
    <migrations src="migrations"/>
    <css>
        <file src="src/exported.css"/>
    </css>
    <attributes>
        <attribute src="Attributes/TemplateAttribute"/>
    </attributes>
</plugin>
